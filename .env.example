# === Общее окружение ===
NODE_ENV=development
APP_NAME=TaskFlow
PORT=3000
FRONTEND_URL=http://localhost:5173

# === PostgreSQL ===
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow_dev_password
POSTGRES_DB=taskflow_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://taskflow:taskflow_dev_password@localhost:5432/taskflow_db?schema=public

# === Безопасность и сессии ===
SESSION_SECRET=change_me_to_random_64_char_hex_string_in_real_env
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# === Флаги рубежа 50% ===
AUTO_APPROVE_TEACHERS=true
EMAIL_VERIFICATION_REQUIRED=false
